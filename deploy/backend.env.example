# Supabase transaction pooler; URL-encode special password characters.
DATABASE_URL=postgresql://postgres.nnxyouxuxvxrvggklqvf:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Supabase signs its pooler certificate with its own root CA (shipped in the image).
# Remove this line for a database whose certificate chains to a public CA (e.g. Neon).
PGSSLROOTCERT=/app/certs/supabase-prod-ca-2021.crt
SUPABASE_URL=https://nnxyouxuxvxrvggklqvf.supabase.co
SUPABASE_SERVICE_KEY=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
N8N_API_URL=http://n8n:5678
N8N_API_KEY=
# Shared secret n8n sends as X-N8N-Secret to /api/n8n/webhook/content; blank disables the webhook.
N8N_WEBHOOK_SECRET=
BACKEND_INTERNAL_URL=http://backend:8001
# Empty supports same-origin VPS routing. Add exact staging origins if required.
CORS_ORIGINS=
# Enable only for first initialization; existing tables are never altered by this.
AUTO_CREATE_TABLES=false
