---
import '../styles/global.css';
// Import font dari Google Fonts agar mirip
import '@fontsource/merriweather/700.css';
import '@fontsource/merriweather/900.css'; // Untuk headline super tebal
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | Company Profile</title>
		<style is:global>
			/* DEFINISI WARNA GLOBAL DI SINI */
			:root {
				--color-brand: #27e7e7; /* Hijau Deloitte (Ganti dengan warna logo Anda) */
				--color-dark: #000000;  /* Hitam pekat untuk header */
				--color-accent: #1827ca; /* Abu-abu sangat muda untuk background section */
			}
		</style>
	</head>
	<body class="bg-white font-sans text-gray-800 antialiased">
		
		<header class="bg-dark text-white border-b-4 border-brand sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
				<div class="text-2xl font-serif font-black tracking-tighter">
					TRIAD PROTEKSIBER<span class="text-brand">.</span>
				</div>

				<nav class="hidden md:flex space-x-8 text-sm font-semibold tracking-wide uppercase">
					<a href="#" class="hover:text-brand transition-colors">Services</a>
					<a href="#" class="hover:text-brand transition-colors">Insights</a>
					<a href="#" class="hover:text-brand transition-colors">Careers</a>
					<a href="#" class="hover:text-brand transition-colors">Contact</a>
				</nav>
			</div>
		</header>

		<slot />

		<footer class="bg-dark text-gray-400 py-12 border-t border-gray-800 mt-20">
			<div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-8 text-sm">
				<div>
					<h3 class="text-white font-bold mb-4 uppercase tracking-wider">Address</h3>
					<p>Menara Sentraya, Lt. 22</p>
					<p>Jakarta Selatan, Indonesia</p>
				</div>
				<div>
					<h3 class="text-white font-bold mb-4 uppercase tracking-wider">Connect</h3>
					<p>info@triadproteksiber.digital</p>
					<p>+62 21 5555 8888</p>
				</div>
				<div class="border-t border-gray-700 pt-4 md:border-0 md:pt-0">
					<p>&copy; 2026 TRIAD PROTEKSIBER. All rights reserved.</p>
				</div>
			</div>
		</footer>
	</body>
</html>